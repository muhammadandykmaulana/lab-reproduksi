# /etc/bodyguard/cloudflare.env - dipakai cf-guard.py (root:root, izin 600). Diisi lewat: sudo bash atur-token.sh cloudflare
CF_AUTH_TOKEN=""
CF_ACCOUNT_ID=""
CF_ZONE_ID=""
CF_RULESET_ID=""
CF_RULE_ID=""
CF_LIST_NAME="hacker"
CG_OFFICE_IPS=""
# Bot SOC (tanya-jawab /ringkas /ip /blok); bawaan: bot notifikasi. Pesan dikirim lewat notify-run.sh --pesan.
CG_TG_TOKEN=""
CG_CHAT_ID=""
CG_APPROVER_IDS=""
CG_VIEW_CHATS=""
# Kunci Attack ID (kode pendek IP), bukan kunci tombol. Tombol persetujuan ada di gerbang SOC-IR (gatekeeper.env).
CG_HMAC_KEY=""
# Pengaju usulan T2 ke SATU gerbang persetujuan (bawaan bila kosong):
# CG_GERBANG="runuser -u guard -- /opt/bodyguard/bin/bodyguard propose cf"
