# /etc/cek-disk.env - dipakai cek-disk.py dan backup_vps.py (root:root, izin 600)
# Pesan teks dikirim lewat notify-run.sh --pesan; unggah berkas backup tingkat 2 tetap oleh backup_vps.py.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# TELEGRAM_API_BASE="https://api.telegram.org"   # Bot API lokal (http://127.0.0.1:8081) bila ingin kirim berkas sampai 2 GB
# BACKUP_VPS_DIR="/var/opt/BACKUP/vps"
# EPRINTS_RCLONE_REMOTE="eprints:"
# EPRINTS_RCLONE_EXTRA=""
# EPRINTS_TOLERATE_FILES="0"
