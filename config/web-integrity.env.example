# /etc/web-integrity.env - konfigurasi bersama skrip audit (root:root, izin 600).
# Diisi oleh install.sh dan atur-token.sh. JANGAN disalin ke folder lab, GitHub, atau dikirim lewat chat.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# IP admin yang dikecualikan dari peringatan dan blokir (pisahkan spasi); diisi otomatis oleh ip-kantor-sync.sh bila dipakai
IP_KANTOR=""
OJS_DB=""
OJS_SITE=""
# ---- opsional (nilai bawaan ditulis di belakang tanda =) ----
# WEBROOT="/var/www/html"
# BUKTI_DIR="/var/opt/bukti"
# BACKUP_WEB_DIR="/var/opt/BACKUP/web"
# BACKUP_DB_DIR="/var/opt/BACKUP/DB"
# BACKUP_VPS_DIR="/var/opt/BACKUP/vps"
# SKIP_SITES="html default"
# GIT_BACKUP="0"
# GIT_REMOTE_BASE="git@gitlab.com:nama-grup"
# ABUSEIPDB_KEY=""
# ---- ip-kantor-sync.sh: IP kantor tetap + nama DDNS untuk IP rumah yang berubah-ubah ----
# IP_KANTOR_TETAP="203.0.113.10"
# IP_KANTOR_DDNS="admin-rumah.duckdns.org"
# ---- ip-report.sh: batasi database WordPress yang dibaca (pola LIKE, bawaan semua) ----
# WP_DB_LIKE="%"
