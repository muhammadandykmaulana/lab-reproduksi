#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
"""bg-root - SATU-SATUNYA pintu root Bodyguard HITL (dipanggil `guard` lewat sudo).

Dipasang: /usr/local/sbin/bg-root (root:root 0755). Hanya memakai pustaka standar Python 3.6+.

Mengapa wrapper, bukan `chmod 000 /var/www/...*` langsung di sudoers?
  Wildcard sudoers cocok dengan spasi dan '..', sehingga `chmod 000 /var/www/html/*` juga cocok dengan
  `chmod 000 /var/www/html/x /etc/shadow` atau `/var/www/html/../../etc/passwd`. Selain itu penyerang
  (www-data) bisa mengganti file target dengan symlink di antara cek dan chmod (TOCTOU). Wrapper ini
  menutup semua celah itu.

Prinsip:
  * Tanpa shell. Perintah eksternal dijalankan dengan argv list, path absolut, env minimal.
  * Path ditelusuri komponen-per-komponen dari "/" dengan O_NOFOLLOW (symlink di mana pun = tolak);
    file dibuka sekali, lalu bukti, hash, chown, dan chmod dikerjakan pada fd yang sama (anti TOCTOU).
  * Hanya bertindak di root yang tercantum di /etc/bodyguard/root.conf (milik root, tidak writable g/o).
  * Whitelist IP (Cloudflare wajib ada) dan rate cap dicek ULANG di sisi root: pertahanan berlapis bila
    user guard disusupi atau logikanya keliru.
  * Bukti (salinan + SHA256 + metadata) disimpan SEBELUM perubahan izin apa pun, lewat fungsi bersama bukti.py
    (sama dengan collect3_evidence.sh dan persistence-killer.sh). Isi dibaca bg-root dari fd yang aman lalu
    diteruskan lewat STDIN; bukti.py memverifikasi SHA256-nya.
  * Blokir IP TIDAK memakai ipset: satu jalur blokir lewat cf-guard.py (daftar IP Cloudflare ber-TTL).
  * Tidak ada rm/unlink/truncate pada data situs. Karantina = rename di direktori yang sama (reversibel).

Keluaran: satu baris JSON di stdout.
Kode keluar: 0 ok, 2 argumen salah, 3 ditolak validasi, 4 rate cap, 5 gagal.

Sub-perintah (persis seperti ini; lihat /etc/sudoers.d/guard-bodyguard):
  contain          --incident <INC-ID> -- <path>
  cf-block         <ip> <ttl-detik>                         (T1, lewat cf-guard.py block)
  quarantine       --incident <INC-ID> --expect-sha256 <hex> -- <path>
  plugin-disable   --incident <INC-ID> -- <path-plugin>
  integrity-accept --incident <INC-ID>
  cf-approve       --incident <INC-ID> --id <12-hex>          (T2, lewat cf-guard.py approve)
  selftest
"""

import configparser
import errno
import fcntl
import glob
import hashlib
import ipaddress
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import time

try:
    import syslog
except ImportError:  # pragma: no cover
    syslog = None

CONFIG_PATH = "/etc/bodyguard/root.conf"
STATE_DIR = "/var/lib/bodyguard-root"
SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C"}
INCIDENT_RE = re.compile(r"\AINC-\d{8}-\d{6}-[0-9a-f]{4}\Z")
SHA256_RE = re.compile(r"\A[0-9a-f]{64}\Z")
PHP_MARKER_RE = re.compile(rb"(?i)<\?php|<\?=|__halt_compiler")
STRONG_MARKER_RE = re.compile(rb"(?i)<\?php|__halt_compiler")
SAFE_PATH_RE = re.compile(rb"\A/[A-Za-z0-9._/@+=,-]{1,4000}\Z")
PLUGIN_NAME_RE = re.compile(rb"\A[A-Za-z0-9_][A-Za-z0-9._-]{0,119}\Z")
IP_CHARS_RE = re.compile(r"\A[0-9A-Fa-f:.]{2,45}\Z")
IMAGE_EXT = (b".jpg", b".jpeg", b".png", b".gif", b".webp", b".bmp", b".ico", b".tif", b".tiff",
             b".svg", b".heic", b".avif")
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
EXIT_OK, EXIT_USAGE, EXIT_REFUSED, EXIT_RATECAP, EXIT_FAIL = 0, 2, 3, 4, 5
CAP_SECTION = {"contain": "contain", "blokir": "blokir", "quarantine": "quarantine",
               "plugin": "plugins", "integrity": "integrity", "cfapprove": "cfguard"}
DEFAULT_CAPS = {"contain": 8, "blokir": 25, "quarantine": 20, "plugin": 10, "integrity": 2, "cfapprove": 20}
CF_ID_RE = re.compile(r"\A[0-9a-f]{12}\Z")
ALWAYS_PROTECTED = (("loopback", "127.0.0.0/8"), ("loopback", "::1/128"), ("this-network", "0.0.0.0/8"))


class BgError(Exception):
    code = EXIT_FAIL


class Usage(BgError):
    code = EXIT_USAGE


class Refused(BgError):
    code = EXIT_REFUSED


class RateCapped(BgError):
    code = EXIT_RATECAP


class Failed(BgError):
    code = EXIT_FAIL


class Ctx(object):
    def __init__(self, cp, state_dir, require_root, now):
        self.cp = cp
        self.state_dir = state_dir
        self.require_root = require_root
        self.now = now


# ----------------------------------------------------------------------------------------------
# helper umum
# ----------------------------------------------------------------------------------------------
def _errname(e):
    return errno.errorcode.get(getattr(e, "errno", None), e.__class__.__name__)


def _clean(value, max_len=300):
    if isinstance(value, (bytes, bytearray)):
        value = bytes(value).decode("utf-8", "replace")
    out = []
    for ch in str(value):
        o = ord(ch)
        out.append("\\x%02x" % o if (o < 0x20 or o == 0x7F or 0x80 <= o <= 0x9F) else ch)
    s = "".join(out)
    return s if len(s) <= max_len else s[:max_len] + "...[+%d]" % (len(s) - max_len)


def _p(path_b):
    return os.fsdecode(path_b)


def _q(path_b):
    return shlex.quote(_clean(_p(path_b), 4096))


def _bounded(value, lo, hi):
    return max(lo, min(hi, int(value)))


def _write_all(fd, data):
    view = memoryview(data)
    while view:
        n = os.write(fd, view)
        view = view[n:]


def _read_fd(fd, limit):
    chunks, off = [], 0
    while True:
        b = os.pread(fd, 1 << 20, off)
        if not b:
            break
        off += len(b)
        if off > limit:
            raise Refused("file lebih besar dari batas %d byte" % limit)
        chunks.append(b)
    data = b"".join(chunks)
    return data, hashlib.sha256(data).hexdigest()


def load_config(path, require_root):
    try:
        st = os.lstat(path)
    except OSError:
        raise Refused("root.conf tidak ditemukan: %s" % path)
    if not stat.S_ISREG(st.st_mode):
        raise Refused("root.conf harus file biasa (bukan symlink)")
    if require_root and (st.st_uid != 0 or st.st_mode & 0o022):
        raise Refused("root.conf harus milik root dan tidak writable group/other")
    cp = configparser.ConfigParser(interpolation=None, strict=True)
    with open(path, "r", encoding="utf-8") as f:
        cp.read_file(f)
    return cp


def _check_trusted_file(path, require_root, what):
    if not path.startswith("/"):
        raise Refused("%s harus path absolut" % what)
    try:
        st = os.lstat(path)
    except OSError:
        raise Refused("%s tidak ditemukan: %s" % (what, path))
    if not stat.S_ISREG(st.st_mode):
        raise Refused("%s harus file biasa (bukan symlink): %s" % (what, path))
    if require_root and (st.st_uid != 0 or st.st_mode & 0o022):
        raise Refused("%s harus milik root dan tidak writable group/other: %s" % (what, path))
    return st


def _incident(raw):
    s = raw.decode("ascii", "replace")
    if not INCIDENT_RE.match(s):
        raise Usage("ID insiden tidak valid")
    return s


def _parse_incident_path(args):
    if len(args) != 4 or args[0] != b"--incident" or args[2] != b"--":
        raise Usage("format: --incident <INC-ID> -- <path>")
    return _incident(args[1]), args[3]


def _roots(ctx, section, key):
    roots = []
    for item in ctx.cp.get(section, key, fallback="").split():
        if not item.startswith("/"):
            raise Refused("[%s] %s: path harus absolut" % (section, key))
        cands = sorted(glob.glob(item)) if any(ch in item for ch in "*?[") else [item]
        for cand in cands:
            norm = os.path.normpath(cand)
            if os.path.realpath(norm) != norm:
                _syslog_raw("WARN root dilewati karena mengandung symlink: %s" % _clean(norm))
                continue
            if os.path.isdir(norm):
                b = os.fsencode(norm)
                if b not in roots:
                    roots.append(b)
    roots.sort(key=len, reverse=True)
    return roots


def _split_under(path_b, roots):
    if (not isinstance(path_b, bytes) or not path_b.startswith(b"/") or b"\x00" in path_b
            or len(path_b) > 4096):
        raise Refused("path target tidak valid")
    for root in roots:
        prefix = root.rstrip(b"/") + b"/"
        if path_b.startswith(prefix):
            parts = path_b[len(prefix):].split(b"/")
            if not parts or any(p in (b"", b".", b"..") for p in parts):
                raise Refused("komponen path target tidak valid")
            return root, parts
    raise Refused("path di luar root yang diizinkan root.conf")


def _open_dir(path_b):
    """Buka direktori absolut komponen-per-komponen dari '/' dengan O_NOFOLLOW."""
    if not path_b.startswith(b"/") or b"\x00" in path_b:
        raise Refused("path direktori tidak valid")
    fd = os.open(b"/", os.O_RDONLY | os.O_DIRECTORY | O_CLOEXEC)
    try:
        for comp in path_b.split(b"/"):
            if not comp:
                continue
            if comp in (b".", b".."):
                raise Refused("komponen '.'/'..' ditolak")
            nfd = os.open(comp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
    except OSError as e:
        os.close(fd)
        raise Refused("tidak bisa menelusuri direktori (%s): ada symlink atau bukan direktori" % _errname(e))
    except BaseException:
        os.close(fd)
        raise
    return fd


def _open_target(root, parts):
    parent = root.rstrip(b"/") + ((b"/" + b"/".join(parts[:-1])) if len(parts) > 1 else b"")
    dfd = _open_dir(parent)
    name = parts[-1]
    try:
        ffd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | O_CLOEXEC, dir_fd=dfd)
    except OSError as e:
        os.close(dfd)
        raise Refused("tidak bisa membuka file target (%s)" % _errname(e))
    try:
        st = os.fstat(ffd)
        if not stat.S_ISREG(st.st_mode):
            raise Refused("target bukan file biasa")
        if st.st_nlink != 1:
            raise Refused("target punya hardlink (nlink=%d) - ditolak" % st.st_nlink)
    except BaseException:
        os.close(ffd)
        os.close(dfd)
        raise
    return dfd, ffd, name, st, parent


def _entry_changed(dfd, name, st):
    try:
        cur = os.stat(name, dir_fd=dfd, follow_symlinks=False)
    except OSError:
        return True
    return (cur.st_dev, cur.st_ino) != (st.st_dev, st.st_ino)


def _exists(dfd, name):
    try:
        os.stat(name, dir_fd=dfd, follow_symlinks=False)
        return True
    except FileNotFoundError:
        return False


def _lock_fd(ctx, ffd):
    """chown root:root lalu chmod 000 pada fd (inode yang sudah dihash).

    chown dulu karena pemilik file (www-data) selalu bisa membatalkan chmod pada file miliknya sendiri.
    Di mode uji non-root (require_root=False) chown dilewati karena memang tidak mungkin.
    """
    if ctx.require_root:
        os.fchown(ffd, 0, 0)
    os.fchmod(ffd, 0)
    after = os.fstat(ffd)
    if stat.S_IMODE(after.st_mode) != 0 or (ctx.require_root and after.st_uid != 0):
        raise Failed("verifikasi chown root + chmod 000 gagal")


def _require_php_marker(name, data):
    rx = STRONG_MARKER_RE if name.lower().endswith(IMAGE_EXT) else PHP_MARKER_RE
    if not rx.search(data):
        raise Refused("tidak ada penanda kode PHP pada isi file - aksi dibatalkan")


def _ratecap(ctx, action):
    cap = _bounded(ctx.cp.getint(CAP_SECTION[action], "hourly_cap", fallback=DEFAULT_CAPS[action]), 1, 200)
    try:
        os.mkdir(ctx.state_dir, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(ctx.state_dir)
    if not stat.S_ISDIR(st.st_mode) or (ctx.require_root and (st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o077)):
        raise Refused("state dir sisi root tidak aman: %s" % ctx.state_dir)
    fd = os.open(os.path.join(ctx.state_dir, "ratecap.json"),
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        raw, _ = _read_fd(fd, 1 << 20)
        try:
            data = json.loads(raw.decode("utf-8") or "{}")
            if not isinstance(data, dict):
                data = {}
        except ValueError:
            data = {}
        recent = [float(t) for t in data.get(action, [])
                  if isinstance(t, (int, float)) and 0 <= ctx.now - float(t) < 3600]
        if len(recent) >= cap:
            raise RateCapped("rate cap sisi root untuk %s tercapai (%d/jam)" % (action, cap))
        recent.append(ctx.now)
        data[action] = recent
        blob = json.dumps(data, sort_keys=True).encode("ascii")
        os.ftruncate(fd, 0)
        os.lseek(fd, 0, os.SEEK_SET)
        _write_all(fd, blob)
        os.fsync(fd)
    finally:
        os.close(fd)


def _evidence(ctx, incident, data, sha, meta):
    """Simpan salinan bukti lewat fungsi bersama bukti.py (salinan 0400 bernama SHA256, metadata JSON, MANIFEST.tsv).
    Isi dikirim lewat STDIN; bukti.py menolak bila hash tidak cocok atau ruang disk di bawah min_free_bytes."""
    edir = ctx.cp.get("contain", "evidence_dir", fallback="/var/opt/bukti").strip()
    if not edir.startswith("/"):
        raise Refused("evidence_dir harus path absolut")
    bukti = ctx.cp.get("contain", "bukti_bin", fallback="").strip()
    if not bukti:
        raise Refused("bukti_bin belum dikonfigurasi di root.conf - bukti tidak bisa disimpan, aksi dibatalkan")
    _check_trusted_file(bukti, ctx.require_root, "bukti_bin")
    min_free = _bounded(ctx.cp.getint("contain", "min_free_bytes", fallback=2 * 1024 ** 3), 0, 1024 ** 4)
    argv = [sys.executable, "-I", bukti, "--dir", edir, "simpan-stdin", "--kasus", incident,
            "--label", os.path.basename(meta.get("path", "bukti"))[:80] or "bukti", "--sha256", sha,
            "--meta-json", json.dumps(meta, ensure_ascii=True, sort_keys=True), "--min-free", str(min_free),
            "--maks", str(max(len(data), 1))]
    try:
        p = subprocess.run(argv, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           env=dict(SAFE_ENV), cwd="/", timeout=120, close_fds=True)
    except (OSError, subprocess.SubprocessError) as e:
        raise Failed("bukti.py tidak bisa dijalankan: %s" % _errname(e) if isinstance(e, OSError) else "bukti.py timeout")
    try:
        res = json.loads(p.stdout.decode("ascii", "replace").strip().splitlines()[-1])
    except (ValueError, IndexError):
        res = {}
    if p.returncode == 3:
        raise Refused("bukti.py menolak: %s" % _clean(res.get("galat", ""), 200))
    if p.returncode != 0 or res.get("sha256") != sha:
        raise Failed("penyimpanan bukti gagal: %s" % _clean(res.get("galat") or p.stderr[-200:], 200))
    return res.get("path") or os.path.join(edir, incident, sha + ".bin")


def _collect3(ctx, path_b, incident):
    """Panggil collect3_evidence.sh (opsional) HANYA bila path aman untuk skrip shell."""
    script = ctx.cp.get("contain", "collect3", fallback="").strip()
    if not script:
        return {"status": "disabled"}
    if not SAFE_PATH_RE.match(path_b):
        return {"status": "skipped",
                "reason": "nama/path berisi karakter di luar [A-Za-z0-9._/@+=,-]; tidak diteruskan ke skrip shell"}
    try:
        _check_trusted_file(script, ctx.require_root, "collect3")
    except Refused as e:
        return {"status": "refused", "reason": str(e)}
    if not os.access(script, os.X_OK):
        return {"status": "refused", "reason": "collect3 tidak executable"}
    path_s = path_b.decode("ascii")
    template = ctx.cp.get("contain", "collect3_args", fallback="{path}")
    argv = [script] + [a.replace("{path}", path_s).replace("{incident}", incident) for a in shlex.split(template)]
    timeout = _bounded(ctx.cp.getint("contain", "collect3_timeout", fallback=120), 5, 1800)
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           env=dict(SAFE_ENV), cwd="/", timeout=timeout, close_fds=True)
    except subprocess.TimeoutExpired:
        return {"status": "timeout"}
    except OSError as e:
        return {"status": "error", "reason": _errname(e)}
    return {"status": "ok" if p.returncode == 0 else "rc=%d" % p.returncode,
            "out_tail": _clean(p.stdout[-400:]), "err_tail": _clean(p.stderr[-400:])}


def _meta(ctx, incident, action, path_b, st, sha, size):
    return {
        "incident": incident, "action": action, "path": _p(path_b), "sha256": sha, "size": size,
        "mode": "%04o" % stat.S_IMODE(st.st_mode), "uid": st.st_uid, "gid": st.st_gid,
        "mtime": st.st_mtime, "ctime": st.st_ctime, "inode": st.st_ino, "dev": st.st_dev,
        "captured_at": ctx.now, "sudo_user": _clean(os.environ.get("SUDO_USER", ""), 64),
    }


# ----------------------------------------------------------------------------------------------
# sub-perintah
# ----------------------------------------------------------------------------------------------
def cmd_contain(ctx, args):
    """T1: simpan bukti, lalu chown root:root + chmod 000 pada inode yang sama."""
    incident, path_b = _parse_incident_path(args)
    roots = _roots(ctx, "contain", "data_roots")
    if not roots:
        raise Refused("data_roots kosong/tidak ada di root.conf")
    root, parts = _split_under(path_b, roots)
    max_bytes = _bounded(ctx.cp.getint("contain", "max_file_bytes", fallback=2097152), 1024, 64 * 1024 * 1024)
    dfd, ffd, name, st, _parent = _open_target(root, parts)
    try:
        if st.st_size > max_bytes:
            raise Refused("file %d byte melebihi max_file_bytes; tangani manual" % st.st_size)
        data, sha = _read_fd(ffd, max_bytes)
        _require_php_marker(name, data)
        mode = stat.S_IMODE(st.st_mode)
        original = {"mode": "%04o" % mode, "uid": st.st_uid, "gid": st.st_gid}
        if mode == 0 and (st.st_uid == 0 or not ctx.require_root):
            return {"already_contained": True, "path": _p(path_b), "sha256": sha, "original": original}
        _ratecap(ctx, "contain")
        evidence = _evidence(ctx, incident, data, sha, _meta(ctx, incident, "contain", path_b, st, sha, len(data)))
        replaced = _entry_changed(dfd, name, st)
        # Kunci DULU (webshell langsung mati), baru collect3 sebagai pelengkap forensik.
        _lock_fd(ctx, ffd)
        if replaced or _entry_changed(dfd, name, st):
            c3 = {"status": "skipped", "reason": "entri path berubah; collect3 tidak dipanggil pada path ini"}
        else:
            c3 = _collect3(ctx, path_b, incident)
        res = {
            "path": _p(path_b), "sha256": sha, "size": len(data), "original": original,
            "evidence": evidence, "collect3": c3,
            "rollback": "chown %d:%d -- %s && chmod %s -- %s" % (st.st_uid, st.st_gid, _q(path_b), original["mode"], _q(path_b)),
        }
        if replaced:
            res["warning"] = "entri path berubah setelah dibuka; inode asli sudah dikunci - periksa path ini manual"
        return res
    finally:
        os.close(ffd)
        os.close(dfd)


def cmd_quarantine(ctx, args):
    """T2 (setelah persetujuan): bukti + rename di tempat (tanpa '.php') + root:root 000. Terikat SHA256."""
    if (len(args) != 6 or args[0] != b"--incident" or args[2] != b"--expect-sha256" or args[4] != b"--"):
        raise Usage("format: --incident <INC-ID> --expect-sha256 <hex> -- <path>")
    incident = _incident(args[1])
    expect = args[3].decode("ascii", "replace")
    if not SHA256_RE.match(expect):
        raise Usage("sha256 tidak valid")
    path_b = args[5]
    roots = _roots(ctx, "contain", "data_roots")
    root, parts = _split_under(path_b, roots)
    max_bytes = _bounded(ctx.cp.getint("contain", "max_file_bytes", fallback=2097152), 1024, 64 * 1024 * 1024)
    dfd, ffd, name, st, parent = _open_target(root, parts)
    try:
        if b".bgq-" in name:
            raise Refused("file sudah berstatus karantina")
        if st.st_size > max_bytes:
            raise Refused("file melebihi max_file_bytes")
        data, sha = _read_fd(ffd, max_bytes)
        if sha != expect:
            raise Refused("isi file berubah sejak disetujui (sha256 berbeda) - karantina dibatalkan")
        _require_php_marker(name, data)
        _ratecap(ctx, "quarantine")
        evidence = _evidence(ctx, incident, data, sha, _meta(ctx, incident, "quarantine", path_b, st, sha, len(data)))
        base = re.sub(rb"[^A-Za-z0-9_-]", b"_", name)[:80]
        new_name = base + b".bgq-" + incident.encode("ascii") + b"-" + sha[:12].encode("ascii")
        if _exists(dfd, new_name):
            raise Failed("nama karantina sudah dipakai")
        if _entry_changed(dfd, name, st):
            raise Failed("entri path berubah sebelum rename - dibatalkan")
        os.rename(name, new_name, src_dir_fd=dfd, dst_dir_fd=dfd)
        cur = os.stat(new_name, dir_fd=dfd, follow_symlinks=False)
        if (cur.st_dev, cur.st_ino) != (st.st_dev, st.st_ino):
            os.rename(new_name, name, src_dir_fd=dfd, dst_dir_fd=dfd)
            raise Failed("verifikasi inode setelah rename gagal - dikembalikan")
        _lock_fd(ctx, ffd)
        new_path = parent + b"/" + new_name
        mode = "%04o" % stat.S_IMODE(st.st_mode)
        return {
            "path": _p(path_b), "quarantined_as": _p(new_path), "sha256": sha, "evidence": evidence,
            "original": {"mode": mode, "uid": st.st_uid, "gid": st.st_gid},
            "rollback": "mv -n -- %s %s && chown %d:%d -- %s && chmod %s -- %s" % (
                _q(new_path), _q(path_b), st.st_uid, st.st_gid, _q(path_b), mode, _q(path_b)),
        }
    finally:
        os.close(ffd)
        os.close(dfd)


def cmd_plugin_disable(ctx, args):
    """T2: rename folder/file plugin tingkat-1 di wp-content/plugins -> WordPress tidak memuatnya."""
    incident, path_b = _parse_incident_path(args)
    roots = _roots(ctx, "plugins", "plugin_roots")
    if not roots:
        raise Refused("plugin_roots kosong/tidak ada di root.conf")
    root, parts = _split_under(path_b, roots)
    if len(parts) != 1:
        raise Refused("hanya entri plugin tingkat pertama yang boleh")
    name = parts[0]
    if not PLUGIN_NAME_RE.match(name) or b".bg-disabled-" in name:
        raise Refused("nama plugin tidak valid")
    dfd = _open_dir(root)
    try:
        try:
            st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        except OSError as e:
            raise Refused("plugin tidak ditemukan (%s)" % _errname(e))
        if stat.S_ISLNK(st.st_mode):
            raise Refused("plugin berupa symlink - tangani manual")
        if not (stat.S_ISDIR(st.st_mode) or (stat.S_ISREG(st.st_mode) and name.lower().endswith(b".php"))):
            raise Refused("entri plugin bukan direktori atau file .php")
        _ratecap(ctx, "plugin")
        new_name = name + b".bg-disabled-" + incident.encode("ascii")
        if _exists(dfd, new_name):
            raise Failed("nama tujuan sudah dipakai")
        os.rename(name, new_name, src_dir_fd=dfd, dst_dir_fd=dfd)
        cur = os.stat(new_name, dir_fd=dfd, follow_symlinks=False)
        if (cur.st_dev, cur.st_ino) != (st.st_dev, st.st_ino):
            os.rename(new_name, name, src_dir_fd=dfd, dst_dir_fd=dfd)
            raise Failed("verifikasi inode setelah rename gagal - dikembalikan")
        new_path = root.rstrip(b"/") + b"/" + new_name
        return {"path": _p(path_b), "disabled_as": _p(new_path),
                "rollback": "mv -n -- %s %s  (lalu aktifkan ulang dari wp-admin HANYA bila plugin terbukti sah)" % (
                    _q(new_path), _q(path_b))}
    finally:
        os.close(dfd)


def cmd_integrity_accept(ctx, args):
    """T2: jalankan perintah terima-baseline yang TETAP di root.conf (guard tidak bisa memberi argumen)."""
    if len(args) != 2 or args[0] != b"--incident":
        raise Usage("format: --incident <INC-ID>")
    incident = _incident(args[1])
    raw = ctx.cp.get("integrity", "accept_cmd", fallback="").strip()
    if not raw:
        raise Refused("accept_cmd belum dikonfigurasi di root.conf")
    argv = shlex.split(raw)
    _check_trusted_file(argv[0], ctx.require_root, "accept_cmd")
    _ratecap(ctx, "integrity")
    timeout = _bounded(ctx.cp.getint("integrity", "timeout", fallback=840), 10, 840)
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           env=dict(SAFE_ENV), cwd="/", timeout=timeout, close_fds=True)
    except subprocess.TimeoutExpired:
        raise Failed("accept_cmd timeout")
    if p.returncode != 0:
        raise Failed("accept_cmd rc=%d: %s" % (p.returncode, _clean(p.stderr[-300:])))
    return {"incident": incident, "rc": 0, "out_tail": _clean(p.stdout[-400:])}


def _parse_ip(raw):
    s = raw.decode("ascii", "replace")
    if not IP_CHARS_RE.match(s):
        raise Refused("format IP tidak valid")
    try:
        ip = ipaddress.ip_address(s)
    except ValueError:
        raise Refused("format IP tidak valid")
    if ip.version == 6 and ip.ipv4_mapped is not None:
        ip = ip.ipv4_mapped
    if (not ip.is_global or ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast
            or ip.is_reserved or ip.is_unspecified):
        raise Refused("bukan IP global - tidak pernah diblokir")
    return ip


def _load_whitelist(ctx):
    cf = ctx.cp.get("blokir", "cloudflare_file", fallback="").strip()
    if not cf:
        raise Refused("cloudflare_file belum dikonfigurasi - blokir ditolak (fail-closed)")
    sources = [("cloudflare", cf)] + [("whitelist", f) for f in ctx.cp.get("blokir", "whitelist_files", fallback="").split()]
    nets = [(label, ipaddress.ip_network(n)) for label, n in ALWAYS_PROTECTED]
    cf_count = 0
    for label, path in sources:
        _check_trusted_file(path, ctx.require_root, "whitelist")
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.readlines()
        for line in lines:
            item = line.split("#", 1)[0].strip()
            if not item:
                continue
            try:
                net = ipaddress.ip_network(item, strict=False)
            except ValueError:
                raise Refused("whitelist %s berisi entri tidak valid - blokir ditolak (fail-closed)" % path)
            nets.append(("%s:%s" % (label, os.path.basename(path)), net))
            if label == "cloudflare":
                cf_count += 1
    if cf_count == 0:
        raise Refused("daftar IP Cloudflare kosong - blokir ditolak (fail-closed)")
    return nets


def _cfguard(ctx, args, timeout=120):
    """Jalankan cf-guard.py (path TETAP di root.conf, milik root) dan ambil baris JSON terakhirnya."""
    script = ctx.cp.get("cfguard", "bin", fallback="").strip()
    if not script:
        raise Refused("[cfguard] bin belum dikonfigurasi di root.conf")
    _check_trusted_file(script, ctx.require_root, "cfguard bin")
    try:
        p = subprocess.run([sys.executable, "-I", script] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, env=dict(SAFE_ENV), cwd="/", timeout=timeout, close_fds=True)
    except subprocess.TimeoutExpired:
        raise Failed("cf-guard timeout")
    except OSError as e:
        raise Failed("cf-guard tidak bisa dijalankan: %s" % _errname(e))
    res = {}
    for line in reversed(p.stdout.decode("utf-8", "replace").splitlines()):
        if line.strip().startswith("{"):
            try:
                res = json.loads(line)
                break
            except ValueError:
                continue
    if p.returncode != 0 or res.get("ok") is not True:
        err = Refused if p.returncode == 3 else Failed
        raise err("cf-guard rc=%d: %s" % (p.returncode, _clean(res.get("galat") or p.stderr[-200:], 200)))
    return res


def cmd_cf_block(ctx, args):
    """T1: blokir IP ber-TTL lewat cf-guard (satu jalur blokir; kedaluwarsa dicabut cf-guard run berikutnya)."""
    if len(args) != 2:
        raise Usage("format: cf-block <ip> <ttl-detik>")
    ip = _parse_ip(args[0])
    for label, net in _load_whitelist(ctx):
        if ip.version == net.version and ip in net:
            raise Refused("IP %s ada di whitelist (%s %s) - tidak diblokir" % (ip, label, net))
    ttl_s = args[1].decode("ascii", "replace")
    if not re.match(r"\A\d{1,6}\Z", ttl_s):
        raise Usage("ttl harus angka detik")
    ttl = int(ttl_s)
    min_ttl = _bounded(ctx.cp.getint("blokir", "min_ttl", fallback=3600), 60, 86400)
    max_ttl = _bounded(ctx.cp.getint("blokir", "max_ttl", fallback=86400), min_ttl, 86400)
    if not (min_ttl <= ttl <= max_ttl):
        raise Refused("ttl %d di luar %d..%d detik" % (ttl, min_ttl, max_ttl))
    _ratecap(ctx, "blokir")
    res = _cfguard(ctx, ["block", str(ip), "--ttl", str(ttl), "--oleh", "soc-ir"])
    return {"ip": str(ip), "ttl": ttl, "expires_at": ctx.now + ttl, "via": "cf-guard",
            "rollback": "cf-guard.py remove %s" % _clean(res.get("ip") or str(ip), 60)}


def cmd_cf_approve(ctx, args):
    """T2: terapkan usulan cf-guard yang sudah disetujui di gerbang (id usulan saja; nilainya diambil cf-guard)."""
    if len(args) != 4 or args[0] != b"--incident" or args[2] != b"--id":
        raise Usage("format: --incident <INC-ID> --id <12-hex>")
    incident = _incident(args[1])
    rid = args[3].decode("ascii", "replace")
    if not CF_ID_RE.match(rid):
        raise Usage("id usulan harus 12 karakter heksadesimal")
    _ratecap(ctx, "cfapprove")
    res = _cfguard(ctx, ["approve", rid, "--oleh", "gerbang:%s" % incident])
    return {"incident": incident, "status": _clean(res.get("status"), 40), "nilai": _clean(res.get("nilai"), 120),
            "rollback": _clean(res.get("rollback"), 200)}


def cmd_selftest(ctx, args):
    """Diagnostik read-only (tidak mengubah apa pun, tidak memakai rate cap)."""
    if args:
        raise Usage("selftest tidak menerima argumen")
    rep = {"python": sys.version.split()[0]}
    rep["data_roots"] = [_p(r) for r in _roots(ctx, "contain", "data_roots")]
    rep["plugin_roots"] = [_p(r) for r in _roots(ctx, "plugins", "plugin_roots")]
    edir = ctx.cp.get("contain", "evidence_dir", fallback="/var/opt/bukti").strip()
    try:
        st = os.lstat(edir)
        rep["evidence_dir"] = {"path": edir, "mode": "%04o" % stat.S_IMODE(st.st_mode), "uid": st.st_uid,
                               "ok": stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and not stat.S_IMODE(st.st_mode) & 0o077}
    except OSError:
        rep["evidence_dir"] = {"path": edir, "ok": False, "error": "tidak ada"}
    try:
        rep["whitelist_entries"] = len(_load_whitelist(ctx))
    except BgError as e:
        rep["whitelist_entries"] = 0
        rep["whitelist_error"] = str(e)
    for key, sec, opt in (("cfguard", "cfguard", "bin"), ("bukti", "contain", "bukti_bin")):
        path = ctx.cp.get(sec, opt, fallback="").strip()
        try:
            if not path:
                raise Refused("belum dikonfigurasi")
            _check_trusted_file(path, ctx.require_root, key)
            rep[key] = "ok"
        except BgError as e:
            rep[key] = str(e)
    script = ctx.cp.get("contain", "collect3", fallback="").strip()
    if script:
        try:
            _check_trusted_file(script, ctx.require_root, "collect3")
            rep["collect3"] = "ok" if os.access(script, os.X_OK) else "tidak executable"
        except BgError as e:
            rep["collect3"] = str(e)
    else:
        rep["collect3"] = "disabled"
    rep["integrity_accept_cmd"] = "configured" if ctx.cp.get("integrity", "accept_cmd", fallback="").strip() else "kosong"
    return rep


COMMANDS = {
    "contain": cmd_contain,
    "cf-block": cmd_cf_block,
    "cf-approve": cmd_cf_approve,
    "quarantine": cmd_quarantine,
    "plugin-disable": cmd_plugin_disable,
    "integrity-accept": cmd_integrity_accept,
    "selftest": cmd_selftest,
}


def _syslog_raw(msg):
    if syslog is None or not _SYSLOG_ENABLED[0]:
        return
    try:
        syslog.openlog("bg-root", syslog.LOG_PID, syslog.LOG_AUTHPRIV)
        syslog.syslog(syslog.LOG_NOTICE, msg)
    except Exception:
        pass


_SYSLOG_ENABLED = [False]


def main(argv, config_path=CONFIG_PATH, state_dir=STATE_DIR, require_root=True, out=None, now=None):
    out = out or sys.stdout
    sub = argv[0] if argv else ""
    if isinstance(sub, bytes):
        sub = sub.decode("ascii", "replace")
    result = {"action": _clean(sub, 40)}
    code = EXIT_OK
    _SYSLOG_ENABLED[0] = require_root
    old_umask = os.umask(0o077)
    try:
        if require_root and os.geteuid() != 0:
            raise Refused("bg-root harus dijalankan sebagai root (via sudo)")
        if sub not in COMMANDS:
            raise Usage("sub-perintah yang dikenal: %s" % ", ".join(sorted(COMMANDS)))
        cp = load_config(config_path, require_root)
        ctx = Ctx(cp, state_dir, require_root, time.time() if now is None else float(now))
        args = [a if isinstance(a, bytes) else os.fsencode(a) for a in argv[1:]]
        res = COMMANDS[sub](ctx, args)
        result.update(res or {})
        result["ok"] = True
    except BgError as e:
        code = e.code
        result.update({"ok": False, "error": e.__class__.__name__, "detail": _clean(str(e))})
    except Exception as e:  # jangan pernah bocorkan traceback; cukup jenis galat
        code = EXIT_FAIL
        result.update({"ok": False, "error": "Internal", "detail": e.__class__.__name__})
    finally:
        os.umask(old_umask)
    line = json.dumps(result, ensure_ascii=True, sort_keys=True)
    out.write(line + "\n")
    out.flush()
    _syslog_raw("rc=%d sudo_user=%s %s" % (code, _clean(os.environ.get("SUDO_USER", "-"), 32), line[:1500]))
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
