# /etc/sudoers.d/guard-bodyguard - Bodyguard HITL (STAI Ali)
#
# Pasang HANYA setelah lolos validasi:
#   visudo -cf guard-bodyguard && install -m 0440 -o root -g root guard-bodyguard /etc/sudoers.d/guard-bodyguard
# Nama file sengaja TANPA titik: sudo mengabaikan file di sudoers.d yang namanya mengandung '.' atau berakhiran '~'.
#
# Dua user terpisah:
#   guard          pemindai (memproses data penyerang)  -> HANYA aksi T1 (dibatasi breaker + rate cap root)
#   guard-approve  gatekeeper Telegram                  -> HANYA aksi T2 (setelah persetujuan ber-HMAC)
# Bug apa pun di pemindai tidak bisa langsung menjalankan aksi T2, dan pemindai tidak bisa membaca kunci HMAC
# di environment gatekeeper (/proc/<pid>/environ beda uid).
#
# Tidak ada izin chmod/collect3/cf-guard langsung, karena wildcard sudoers TIDAK aman untuk path:
#   `chmod 000 /var/www/html/*` juga cocok dengan `chmod 000 /var/www/html/x /etc/shadow`
#   dan `/var/www/html/../../etc/passwd`, ditambah celah symlink (TOCTOU).
# Validasi argumen yang sesungguhnya (O_NOFOLLOW, root yang diizinkan, penanda PHP, whitelist IP,
# rate cap) dilakukan di dalam bg-root. Pola di bawah hanya mengunci bentuk awal argumen.

User_Alias BG_USERS = guard, guard-approve

Defaults:BG_USERS !requiretty
Defaults:BG_USERS env_reset
Defaults:BG_USERS secure_path="/usr/sbin:/usr/bin:/sbin:/bin"
Defaults:BG_USERS !lecture

# T1 - otomatis (dibatasi circuit breaker sisi guard + rate cap sisi root)
Cmnd_Alias BG_T1 = /usr/local/sbin/bg-root contain --incident *, \
                   /usr/local/sbin/bg-root cf-block *

# T2 - hanya dieksekusi gatekeeper setelah persetujuan Telegram ber-HMAC
Cmnd_Alias BG_T2 = /usr/local/sbin/bg-root quarantine --incident *, \
                   /usr/local/sbin/bg-root plugin-disable --incident *, \
                   /usr/local/sbin/bg-root integrity-accept --incident *, \
                   /usr/local/sbin/bg-root cf-approve --incident *

# Diagnostik read-only, tanpa argumen tambahan
Cmnd_Alias BG_DIAG = /usr/local/sbin/bg-root selftest

guard         ALL=(root) NOPASSWD: BG_T1, BG_DIAG
guard-approve ALL=(root) NOPASSWD: BG_T2, BG_DIAG
