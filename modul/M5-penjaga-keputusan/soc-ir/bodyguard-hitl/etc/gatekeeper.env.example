# /etc/bodyguard/gatekeeper.env - root:root 0600. Dibaca systemd (EnvironmentFile), BUKAN oleh user guard.
# Gatekeeper menolak start bila file ini bukan milik root atau mode-nya bukan 0600.
#
# Token bot APPROVAL (buat bot terpisah lewat @BotFather; JANGAN pakai token bot alert).
BG_APPROVAL_BOT_TOKEN=
# Chat/grup tempat permintaan T2 dikirim (grup: angka negatif, mis. -1001234567890).
BG_APPROVAL_CHAT_ID=
# Allowlist ketat user_id Telegram yang boleh menekan [Setujui]/[Tolak]/freeze, dipisah koma.
# Kosong = semua persetujuan ditolak (fail-closed).
BG_APPROVER_IDS=
# Kunci HMAC tombol (>= 32 byte hex). Buat dengan:  openssl rand -hex 32
BG_HMAC_KEY=
