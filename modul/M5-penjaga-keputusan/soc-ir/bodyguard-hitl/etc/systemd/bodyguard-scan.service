[Unit]
Description=Bodyguard HITL - siklus pindai T0 dan aksi T1 (deterministik)
Documentation=file:///opt/bodyguard/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=guard
Group=guard
# Rahasia bot ALERT (root:root 0600). Tanda '-' = boleh tidak ada (alert jatuh ke log).
EnvironmentFile=-/etc/bodyguard/alert.env
ExecStart=/opt/bodyguard/bin/bodyguard run
UMask=0007
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=45min
# Pengerasan yang AMAN untuk sudo. JANGAN tambahkan NoNewPrivileges=yes atau RestrictSUIDSGID=yes:
# keduanya mematikan sudo -> semua aksi T1 gagal (gagal aman, tapi Bodyguard jadi buta-aksi).
# ProtectHome sengaja tidak dipakai bila collect3_evidence.sh berada di /root.
PrivateTmp=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
